# Copy this file to secrets/.env and fill in real values.
# NEVER commit the real secrets/.env.

# Resensys API v3 key (required for checkers, charts, device type counting)
API_KEY=your-api-key

# Resensys portal login (bridge_info.py)
RESENSYS_USERNAME=your-resensys-username
RESENSYS_PASSWORD=your-resensys-password

# MySQL (data_consumption.py + bridges_api_new.php)
SQL_HOST=gpark.gr
SQL_PORT=3306
SQL_DATABASE=kalamata_gpark
SQL_USERNAME=your-db-username
SQL_PASSWORD=your-db-password

# bridges_api_new.php external API keys
BRIDGES_API_KEY_STATS=your-stats-key
BRIDGES_API_KEY_STATSC=your-statsc-key
BRIDGES_API_KEY_STATSB=your-statsb-key
